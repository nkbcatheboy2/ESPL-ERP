//// CREATE DATABASE CREATE DATABASE auth_system; USE auth_system;

CREATE TABLE users ( id INT AUTO_INCREMENT PRIMARY KEY, username VARCHAR(50) NOT NULL UNIQUE, password VARCHAR(255) NOT NULL, role ENUM('admin', 'employee', 'gatekeeper') NOT NULL );

CREATE TABLE projects ( id INT AUTO_INCREMENT PRIMARY KEY, client_name VARCHAR(100), mobile VARCHAR(15), work_type VARCHAR(255), budget DECIMAL(10,2) DEFAULT 0.00, team_size INT DEFAULT 0, project_head VARCHAR(100), remarks TEXT, status ENUM('pending', 'approved') DEFAULT 'pending', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP );
